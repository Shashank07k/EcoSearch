{
  "name": "ecosearch-backend",
  "version": "0.1.0",
  "private": true,
  "description": "EcoSearch backend API — Node.js, Express, MongoDB via Mongoose",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seedProducts.js",
