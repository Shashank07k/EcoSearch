# --- EcoSearch backend configuration -------------------------------------
# Copy this file to `.env` and adjust the values. `.env` is git-ignored —
# never commit real credentials.

# Port the API listens on (fallback: 5000)
PORT=5000

# Environment: development | test | production
NODE_ENV=development

# MongoDB connection string (local MongoDB or MongoDB Atlas).
# Local example:   mongodb://127.0.0.1:27017/ecosearch
# Atlas example:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecosearch
MONGODB_URI=mongodb://127.0.0.1:27017/ecosearch

# Allowed CORS origin for browser clients ('*' allows any origin — fine for
# local development, restrict in production, e.g. http://localhost:5173)
CORS_ORIGIN=*

# Optional, backend-only AI credentials. Never use VITE_ or NEXT_PUBLIC_ prefixes.
# Without a key the catalog still works; uncached analysis returns HTTP 503.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
# OpenAI-compatible Chat Completions base URL.
# The provider appends /chat/completions. Remote providers require HTTPS.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Comma-separated fallback models if the primary is temporarily unavailable (503).
# Only use verified Gemini models compatible with the AI_BASE_URL.
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# JWT authentication. Required for register/login and protected endpoints.
# Generate a strong secret, e.g.:  openssl rand -hex 32
# Never commit a real secret and never expose it to the frontend (no VITE_*).
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Basic rate limiting on POST /api/auth/register and /api/auth/login.
# Defaults: max 20 attempts per IP per 15-minute window. Disabled under NODE_ENV=test.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# OPTIONAL development admin bootstrap (used only by `npm run create-admin`).
# Leave blank unless explicitly creating/updating an admin account. The script
# never prints the password. Registering through the API can NEVER assign admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
