# --- EcoSearch frontend configuration -------------------------------------
# Copy this file to `.env` and adjust. Only variables prefixed with VITE_
# are exposed to the browser (see https://vite.dev/guide/env-and-vars).

# Public backend API address only. Never put AI credentials in this file.
# /api uses the Vite development proxy; a deployed frontend can use a full URL.
VITE_API_BASE_URL=/api
